# Copy this file to .env and fill it in. Every variable below is validated when
# the server boots — if one is missing or malformed the process prints which
# one and exits, rather than failing confusingly later.

# ---------- Server ----------
# development | production | test. Controls error detail and CORS strictness.
NODE_ENV=development

# Port the API listens on.
PORT=5000

# Public address of THIS API. Used to build the link inside the verification
# email, so it must be reachable by whoever opens that email.
API_URL=http://localhost:5000

# Your frontend. Two jobs: it is the CORS allowlist, and it is where a user is
# redirected after confirming their address. Required when NODE_ENV=production.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local MongoDB, or an Atlas mongodb+srv:// string. The name after the final
# slash is the database that gets created.
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# ---------- Authentication ----------
# Signs and verifies every JWT. Must be at least 32 characters — a short secret
# can be cracked offline, after which anyone can forge a token for any account.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts. Accepts 15m, 24h, 7d.
JWT_EXPIRES_IN=7d

# ---------- Email verification ----------
# true  = an unconfirmed address cannot log in
# false = the address is recorded as unconfirmed but login still works
# The server refuses to start if this is true while SMTP_HOST is empty, because
# that combination would lock every new user out permanently.
REQUIRE_EMAIL_VERIFICATION=true

# How long a verification link stays valid.
EMAIL_TOKEN_TTL_MINUTES=60

# How long a password-reset link stays valid. Shorter than the verification
# window on purpose: a reset link is a temporary master key to the account.
PASSWORD_RESET_TTL_MINUTES=15

# ---------- SMTP ----------
# Leave SMTP_HOST empty and emails are printed to the terminal instead of sent,
# so local development needs no mail provider at all.
#
# For Gmail: enable 2-Step Verification, then create a 16-character App
# Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS
# (no spaces). Port 465 needs SMTP_SECURE=true; port 587 needs false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Commerce <no-reply@example.com>"

# ---------- Rate limiting ----------
# Failed login and register attempts allowed per IP per window. This is what
# stops someone brute forcing passwords. Successful requests are not counted.
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MINUTES=15

# Ceiling for ALL API traffic from one address, so the public catalogue cannot
# be hammered. The admin panel and /uploads are exempt — both legitimately make
# many requests for a single page.
RATE_LIMIT_MAX=300

# ---------- AdminJS admin panel ----------
# Turn the whole panel off without removing any code.
ADMIN_ENABLED=true

# Where the panel lives. Changing it from /admin to something unguessable is
# not security on its own, but it does keep you out of automated scans.
ADMIN_ROOT_PATH=/admin

# Shown in the panel's top-left corner.
ADMIN_BRAND_NAME=E-Commerce Admin

# Signs the admin session cookie. Must be at least 32 characters and MUST be a
# different value from JWT_SECRET — sharing one secret means cracking either
# gives an attacker both. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_COOKIE_SECRET=

# Bootstrap credentials, for the very first login before any admin account
# exists. Set BOTH or NEITHER. Password must be 12+ characters.
#
# As soon as you can sign in, run:  npm run make:admin your@email.com
# then clear these two lines. A fixed credential that always works is a
# permanent backdoor shared by everyone who can read this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Stripe ----------
# Optional. Leave empty and every Stripe call is skipped — registration and the
# rest of the API work exactly as before.
#
# SERVER-ONLY SECRET. Anyone holding it can read your customers and move money,
# so it must never reach a browser or a git commit. Get it from
# https://dashboard.stripe.com/test/apikeys — it starts with sk_test_ (the
# pk_ key is the publishable one and belongs in your frontend).
#
# After setting it, run once to cover accounts created earlier:
#   npm run stripe:backfill            (dry run)
#   npm run stripe:backfill -- --apply
# ---------------------------------------------------------------------------
# Stripe (test mode)
# ---------------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/test/apikeys — it starts with
# sk_test_. The pk_ key is the PUBLISHABLE one and belongs in the frontend;
# the boot check rejects it here.
#
# Leave empty and the API still runs: every Stripe call becomes a no-op and
# POST /api/v1/payment/create-intent answers 503. Auth, products and cart are
# unaffected.
#
# NEVER commit a real value. This file is the template; .env is gitignored.
STRIPE_SECRET_KEY=

# Webhook signing secret — NOT the API key. Get it from the webhook endpoint's
# page in the Stripe dashboard, or from `stripe listen` while developing.
#
# Without it the webhook endpoint refuses to run, so no payment is ever
# confirmed. Required in production whenever STRIPE_SECRET_KEY is set.
STRIPE_WEBHOOK_SECRET=

# ISO 4217, lowercase, as Stripe expects it. One currency for the whole store.
CURRENCY=pkr

# ---------- Logging ----------
# error | warn | info | silent
LOG_LEVEL=info
